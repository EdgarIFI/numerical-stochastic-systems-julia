# Coverage and allocation traces produced by `julia --code-coverage` and
# `julia --track-allocation`.
*.jl.cov
*.jl.*.cov
*.jl.mem
lcov.info
coverage/

# Host-specific build products of the BinaryProvider and BinDeps packages. These
# record absolute paths belonging to one machine and must never be committed.
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Documentation build output.
docs/build/
docs/site/

# Machine-local package preferences.
LocalPreferences.toml
JuliaLocalPreferences.toml

# Manifest.toml and any version-specific Manifest-vX.Y.toml are deliberately NOT
# ignored. This repository is an application rather than a library: the canonical
# manifest pins the exact package versions used to produce the published results
# and is committed on purpose. See docs/methods/reproducibility.md.

# Generated numerical output. Heavy results are regenerated from the committed
# drivers rather than tracked; small reference summaries are committed inside the
# relevant case-study directory instead. Neither CSV nor TOML is ignored
# globally, because those reference outputs use both formats.
results/
scratch/

# Machine-local assistant configuration. The .claude/ directory itself is not
# ignored, so that shared, non-local configuration may be versioned later.
.claude/settings.local.json

# Editor and operating-system artefacts.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
