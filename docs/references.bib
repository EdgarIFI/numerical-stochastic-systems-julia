% references.bib — bibliography source for Stochastic Systems in Julia
%
% This file is deliberately minimal. Scientific references are added case by
% case, at the gate that implements the case study which actually uses them, and
% each entry is verified against an authoritative source before it is added. No
% entry is preloaded in anticipation, and no incomplete entry is left in place.
%
% Conventions for entries added later:
%
%   * Citation keys are AuthorYearKeyword, for example Bezanson2017Julia.
%   * Every entry carries a DOI where one exists.
%   * Titles protect their capitalisation with braces, as in {{Julia}}.
%   * Page ranges use an en dash written as two hyphens, as in 65--98.
%
% The single entry below is the canonical citation for the Julia language. Its
% metadata was verified against the Crossref record for DOI 10.1137/141000671.

@article{Bezanson2017Julia,
  author    = {Bezanson, Jeff and Edelman, Alan and Karpinski, Stefan and Shah, Viral B.},
  title     = {{Julia}: A Fresh Approach to Numerical Computing},
  journal   = {SIAM Review},
  volume    = {59},
  number    = {1},
  pages     = {65--98},
  year      = {2017},
  publisher = {Society for Industrial and Applied Mathematics},
  doi       = {10.1137/141000671},
}
